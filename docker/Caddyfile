# Published on loopback only (compose.yml), since behind Docker's networking a
# client's address can't be trusted for a private-range check.
https://godmode.{$EUROTON_DOMAIN}:8443 {
    tls {$EUROTON_TLS:internal}
    header Strict-Transport-Security "max-age=31536000"
        route {
        handle /admin/* {
            reverse_proxy http://server:4000
        }
        handle {
            root * /srv/web/godmode
            try_files {path} /index.html
            file_server
        }
    }
}

